<odoo>
    <record id="view_agent_form_tools" model="ir.ui.view">
        <field name="name">ai.bridge.agent.form.tools</field>
        <field name="model">ai.bridge.agent</field>
        <field name="inherit_id" ref="ai_oca_bridge_agent.agent_form_view" />
        <field name="arch" type="xml">
            <xpath expr="//page[@name='grants']" position="before">
                <page string="Tools" name="tools">
                    <field name="tool_ids" widget="many2many_tags" />
                    <p class="text-muted">
                        Declared operations this agent may perform (an
                        <code>ai.tool</code>, including server actions when
                        <code>ai_tool_server_action</code> is installed). They
                        run with the rights of the user talking to the agent.
                        Data read is governed by the grants on the next tab.
                    </p>
                </page>
            </xpath>
        </field>
    </record>
</odoo>
