<odoo>
    <record id="ir_cron_agent_cleanup_queue" model="ir.cron">
        <field name="name">AI agent: Cleanup old message queue</field>
        <field name="model_id" ref="model_ai_bridge_agent_message" />
        <field name="state">code</field>
        <field name="code">model._cleanup_old_messages()</field>
        <field name="interval_number">1</field>
        <field name="interval_type">days</field>
        <field name="active" eval="True" />
    </record>

    <record id="ir_cron_ai_agent_push_queue" model="ir.cron">
        <field name="name">AI agent: Push pending messages</field>
        <field name="model_id" ref="model_ai_bridge_agent_message" />
        <field name="state">code</field>
        <field name="code">model._cron_push_queue()</field>
        <field name="interval_number">1</field>
        <field name="interval_type">minutes</field>
        <field name="active" eval="True" />
    </record>

    <record id="ir_cron_agent_expire_credentials" model="ir.cron">
        <field name="name">AI agent: Expire uncollected credentials</field>
        <field name="model_id" ref="model_ai_bridge_agent_credential" />
        <field name="state">code</field>
        <field name="code">model._cron_expire_credentials()</field>
        <field name="interval_number">10</field>
        <field name="interval_type">minutes</field>
        <field name="active" eval="True" />
    </record>
</odoo>
