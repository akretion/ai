<odoo noupdate="1">
    <!-- Conservative defaults: every internal user, read only. Customers add
         their own tools for their power users. -->
    <record id="grant_partners" model="ai.bridge.agent.grant">
        <field name="sequence">10</field>
        <field name="name">partners</field>
        <field name="description">Search partners: contacts and companies</field>
        <field name="model_name">res.partner</field>
        <field name="method">search_read</field>
        <field name="allowed_group_ids" eval="[(6, 0, [ref('base.group_user')])]" />
        <field name="max_limit">40</field>
    </record>
    <record id="grant_products" model="ai.bridge.agent.grant">
        <field name="sequence">20</field>
        <field name="name">products</field>
        <field name="description">Search products and their sale price</field>
        <field name="model_name">product.template</field>
        <field name="method">search_read</field>
        <field name="allowed_group_ids" eval="[(6, 0, [ref('base.group_user')])]" />
        <field name="max_limit">40</field>
    </record>
</odoo>
