<odoo>
    <record id="group_agent_user" model="res.groups">
        <field name="name">Use the AI assistant</field>
        <field name="category_id" ref="base.module_category_productivity" />
        <field name="comment">
            Members of this group may chat with the AI assistant in
            Discuss. Users outside the group receive a standard refusal answer.
        </field>
    </record>

    <record id="agent_rule_multi_company" model="ir.rule">
        <field name="name">AI agent multi-company</field>
        <field name="model_id" ref="model_ai_bridge_agent" />
        <field
            name="domain_force"
        >['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
    </record>

    <record id="agent_message_rule_multi_company" model="ir.rule">
        <field name="name">Agent message queue multi-company</field>
        <field name="model_id" ref="model_ai_bridge_agent_message" />
        <field
            name="domain_force"
        >['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
    </record>

    <record id="agent_message_rule_own" model="ir.rule">
        <field name="name">Agent message queue: own messages</field>
        <field name="model_id" ref="model_ai_bridge_agent_message" />
        <field name="groups" eval="[(4, ref('group_agent_user'))]" />
        <field name="domain_force">[('user_id', '=', user.id)]</field>
    </record>
</odoo>
