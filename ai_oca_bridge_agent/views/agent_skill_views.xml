<odoo>
    <record id="agent_skill_view_list" model="ir.ui.view">
        <field name="model">ai.bridge.agent.skill</field>
        <field name="arch" type="xml">
            <list string="Skills">
                <field name="sequence" widget="handle" />
                <field name="name" />
                <field name="summary" />
                <field name="tool_names" />
                <field name="agent_ids" widget="many2many_tags" />
                <field name="active" />
            </list>
        </field>
    </record>
    <record id="agent_skill_view_form" model="ir.ui.view">
        <field name="model">ai.bridge.agent.skill</field>
        <field name="arch" type="xml">
            <form string="Skill">
                <sheet>
                    <div class="oe_title">
                        <h1>
                            <field name="name" placeholder="e.g. Accounting answers" />
                        </h1>
                    </div>
                    <group>
                        <field name="summary" />
                        <field name="tool_names" />
                        <field name="active" />
                        <field name="agent_ids" widget="many2many_tags" />
                    </group>
                    <field name="instructions" />
                </sheet>
            </form>
        </field>
    </record>
    <record id="agent_skill_action" model="ir.actions.act_window">
        <field name="name">Skills</field>
        <field name="res_model">ai.bridge.agent.skill</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Add the first skill an agent can load
            </p>
        </field>
    </record>
    <menuitem
        id="menu_agent_skill"
        name="Skills"
        parent="menu_agent_root"
        action="agent_skill_action"
        sequence="30"
    />
</odoo>
