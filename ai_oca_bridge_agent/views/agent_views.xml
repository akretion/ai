<odoo>
    <!-- Tree view -->
    <record id="agent_tree_view" model="ir.ui.view">
        <field name="model">ai.bridge.agent</field>
        <field name="arch" type="xml">
            <list>
                <field name="name" />
                <field name="ai_user_id" />
                <field name="state" />
                <field name="last_poll" />
                <field name="active" widget="boolean_toggle" />
            </list>
        </field>
    </record>

    <!-- Form view -->
    <record id="agent_form_view" model="ir.ui.view">
        <field name="model">ai.bridge.agent</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button
                        name="action_regenerate_token"
                        type="object"
                        string="Regenerate Token"
                        confirm="This will invalidate the current token. Are you sure?"
                        class="btn-secondary"
                    />
                    <button
                        name="action_test_connection"
                        type="object"
                        string="Test Connection"
                        class="btn-primary"
                    />
                    <field name="state" widget="statusbar" />
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1>
                            <field name="name" placeholder="e.g. Main AI agent" />
                        </h1>
                    </div>
                    <group>
                        <group string="Configuration">
                            <field name="active" widget="boolean_toggle" />
                            <field
                                name="company_id"
                                groups="base.group_multi_company"
                            />
                            <field name="ai_user_id" options="{'no_create': True}" />
                            <field name="odoo_url" />
                            <field name="agent_url" />
                        </group>
                        <group string="Security">
                            <field name="webhook_token" password="True" />
                            <field name="webhook_token_previous" password="True" />
                            <field name="token_rotated_at" />
                            <field name="token_grace_minutes" />
                        </group>
                    </group>
                    <group string="Tenant">
                        <group>
                            <field name="tenant_key" />
                            <field name="environment" />
                            <field name="session_scope" />
                        </group>
                        <group string="Access">
                            <field
                                name="allowed_group_ids"
                                widget="many2many_tags"
                                options="{'no_create': True}"
                            />
                            <field name="require_api_key_for_tools" />
                            <field name="denial_cooldown_minutes" />
                        </group>
                    </group>
                    <group string="Odoo tools for the assistant">
                        <group>
                            <field name="allow_user_connect" />
                            <field name="credential_ttl_days" />
                        </group>
                        <group>
                            <field name="tool_access_mode" />
                            <field
                                name="tool_excluded_model_ids"
                                widget="many2many_tags"
                                options="{'no_create': True}"
                            />
                        </group>
                    </group>
                    <group string="Realtime push">
                        <field name="push_enabled" />
                        <field name="push_url" />
                        <field name="push_secret" password="True" />
                        <field name="last_push" />
                        <field
                            name="access_denied_message"
                            colspan="2"
                            placeholder="Standard answer sent to users outside the allowed groups."
                        />
                    </group>
                    <group string="Delivery">
                        <group>
                            <field name="max_batch_size" />
                            <field name="long_poll_timeout" />
                        </group>
                        <group>
                            <field name="claim_ttl_minutes" />
                            <field name="max_attempts" />
                        </group>
                    </group>
                    <group string="Channels">
                        <field
                            name="channel_ids"
                            widget="many2many_tags"
                            options="{'no_create': True}"
                        />
                        <p
                            class="text-muted"
                        >Leave empty to monitor all channels where the AI user is a member.</p>
                    </group>
                    <group string="Statistics">
                        <field name="last_poll" />
                        <field name="last_push" />
                        <field name="pending_count" />
                        <field name="message_count" />
                        <field name="last_error" />
                        <field name="last_error_date" />
                    </group>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_ids" widget="mail_thread" />
                </div>
            </form>
        </field>
    </record>

    <!-- Search view -->
    <record id="agent_search_view" model="ir.ui.view">
        <field name="model">ai.bridge.agent</field>
        <field name="arch" type="xml">
            <search>
                <field name="name" />
                <field name="ai_user_id" />
                <filter
                    name="active"
                    string="Active"
                    domain="[('active', '=', True)]"
                />
                <filter
                    name="inactive"
                    string="Inactive"
                    domain="[('active', '=', False)]"
                />
            </search>
        </field>
    </record>

    <!-- Action -->
    <record id="agent_action" model="ir.actions.act_window">
        <field name="name">AI agents</field>
        <field name="res_model">ai.bridge.agent</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
