<odoo>
    <record id="agent_grant_view_list" model="ir.ui.view">
        <field name="model">ai.bridge.agent.grant</field>
        <field name="arch" type="xml">
            <list string="Data access grants" editable="bottom">
                <field name="sequence" widget="handle" />
                <field name="name" />
                <field name="description" />
                <field name="model_name" />
                <field name="method" />
                <field name="agent_ids" widget="many2many_tags" />
                <field name="allowed_group_ids" widget="many2many_tags" />
                <field name="max_limit" />
                <field name="active" />
            </list>
        </field>
    </record>
    <record id="agent_grant_view_form" model="ir.ui.view">
        <field name="model">ai.bridge.agent.grant</field>
        <field name="arch" type="xml">
            <form string="Data access grant">
                <sheet>
                    <group>
                        <field name="name" />
                        <field name="description" />
                        <field name="model_name" />
                        <field name="method" />
                        <field name="max_limit" />
                        <field name="active" />
                    </group>
                    <group string="Applies to">
                        <field name="agent_ids" widget="many2many_tags" />
                        <field name="allowed_group_ids" widget="many2many_tags" />
                    </group>
                    <group string="Fields">
                        <field name="field_names" />
                    </group>
                </sheet>
            </form>
        </field>
    </record>
    <record id="agent_grant_action" model="ir.actions.act_window">
        <field name="name">Data access</field>
        <field name="res_model">ai.bridge.agent.grant</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Add the first data access grant
            </p>
            <p>
                A grant opens one model, with one read method, to the agents and
                the groups you choose. Grants answer questions; tools perform
                operations.
            </p>
        </field>
    </record>
    <menuitem
        id="menu_agent_grant"
        name="Data access"
        parent="menu_agent_root"
        action="agent_grant_action"
        sequence="20"
    />
</odoo>
