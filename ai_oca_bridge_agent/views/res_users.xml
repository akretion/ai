<odoo>
    <!-- Full user form (Settings > Users). -->
    <record id="view_users_form_hermes" model="ir.ui.view">
        <field name="model">res.users</field>
        <field name="inherit_id" ref="base.view_users_form" />
        <field name="arch" type="xml">
            <xpath expr="//notebook" position="inside">
                <page string="AI assistant" name="agent_ai">
                    <group>
                        <field name="agent_has_api_key" string="Connected" />
                        <field name="agent_credential_expiry" />
                    </group>
                    <div class="text-muted">
                        Connecting hands a dedicated Odoo API key over to the
                        AI agent assistant. The assistant then reads records with
                        <b>your own</b> access rights and record rules; revoking
                        the connection invalidates the key immediately.
                    </div>
                    <div class="mt-3">
                        <button
                            name="action_agent_connect"
                            type="object"
                            string="Connect the assistant"
                            class="btn-primary"
                            invisible="agent_has_api_key"
                        />
                        <button
                            name="action_agent_disconnect"
                            type="object"
                            string="Disconnect"
                            class="btn-secondary"
                            invisible="not agent_has_api_key"
                            confirm="The assistant will lose access to your Odoo records."
                        />
                    </div>
                </page>
            </xpath>
        </field>
    </record>
    <!-- "Preferences" dialog from the user menu: a different, simplified form
         (base.view_users_form_simple_modif), so it needs its own page. -->
    <record id="view_users_form_simple_modif_hermes" model="ir.ui.view">
        <field name="model">res.users</field>
        <field name="inherit_id" ref="base.view_users_form_simple_modif" />
        <field name="arch" type="xml">
            <xpath expr="//notebook" position="inside">
                <page string="AI assistant" name="agent_ai">
                    <group>
                        <field name="agent_has_api_key" string="Connected" />
                        <field name="agent_credential_expiry" />
                    </group>
                    <div class="text-muted">
                        Connecting hands a dedicated Odoo API key over to the
                        AI agent assistant. The assistant then reads records with
                        <b>your own</b> access rights and record rules; revoking
                        the connection invalidates the key immediately.
                    </div>
                    <div class="mt-3">
                        <button
                            name="action_agent_connect"
                            type="object"
                            string="Connect the assistant"
                            class="btn-primary"
                            invisible="agent_has_api_key"
                        />
                        <button
                            name="action_agent_disconnect"
                            type="object"
                            string="Disconnect"
                            class="btn-secondary"
                            invisible="not agent_has_api_key"
                            confirm="The assistant will lose access to your Odoo records."
                        />
                    </div>
                </page>
            </xpath>
        </field>
    </record>
</odoo>
